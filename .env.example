DB_URL=jdbc:postgresql://db:5432/webappfoundation
DB_USERNAME=postgres
DB_PASSWORD=changeme
POSTGRES_DB=webappfoundation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
VITE_API_URL=http://localhost:8080
# Spring profile. 'dev' (default) carries local convenience defaults; set to 'prod' in production,
# where NO weak defaults exist and the app fails fast on missing/weak secrets.
SPRING_PROFILES_ACTIVE=dev
# Required in prod (the app refuses to start without a >=32-byte value). Dev falls back to a demo key.
JWT_SECRET=change-this-to-a-secure-random-256-bit-secret
JWT_EXPIRATION_MS=86400000
# Short TTL (ms) for email challenge / password-reset links (default 15 min).
JWT_CHALLENGE_EXPIRATION_MS=900000
# Login lockout: lock an account after N consecutive failures for M minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# CORS allowlist: comma-separated exact origins allowed to call the API from a browser (never "*").
# In prod set this to the site's frontend origin, e.g. https://app.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Email-OTP 2FA: how long an emailed login code stays valid.
OTP_TTL_MINUTES=10
# Public base URL used to build links in emails (e.g. the password-reset link).
APP_BASE_URL=http://localhost:8080

ADMIN_EMAIL=owner@yourbusiness.com
# Prod must set a non-default password; the app refuses to seed the admin with a blank/known default.
ADMIN_PASSWORD=changeme123
# Email / SMTP. For local dev point at the compose 'mailpit' service:
#   SMTP_HOST=mailpit  SMTP_PORT=1025  SMTP_AUTH=false  SMTP_STARTTLS=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=No Reply <no-reply@example.local>

# Auto-added by EnvVarScanner
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required to verify Razorpay webhooks. Verification fails CLOSED: with no secret a webhook is
# rejected in prod. (Dev accepts unsigned webhooks via the dev profile.)
RAZORPAY_WEBHOOK_SECRET=

# Image storage (MinIO S3-compatible object store — see docker-compose 'minio' service).
# To use real AWS S3 instead: set S3_ENDPOINT blank, S3_PATH_STYLE=false, real keys/region/bucket.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PATH_STYLE=true
MAX_UPLOAD_SIZE=10MB
