{
  "_comment": "The foundation's self-declaration of its features and the pipeline seams each contributes. The discovery-worker pipeline reads this at clone time (FoundationManifest.load) and projects every 'what to skip / never strip / how to gate / which paths are fenced' set from it — so ONBOARDING A NEW FOUNDATION FEATURE IS AN EDIT HERE (plus its FOUNDATION_CONTRACT.md shapes), never a pipeline code change. Keep this in sync with the code you ship: add a feature = add an entry; change a fenced module's public surface = update the matching entry AND the contract card in the same commit. Unknown fields are ignored; a missing/malformed file makes the pipeline fall back to its built-in default.",
  "features": [
    {
      "id": "auth",
      "core": true,
      "requires": ["email"],
      "backend": {
        "controllers": ["AuthController.java", "admin/AdminUserController.java"],
        "packages": ["security", "config/SecurityConfig"],
        "fenced": [
          "User", "Role", "UserRepository", "UserService", "UserDetailsServiceImpl",
          "JwtUtil", "JwtService", "JwtTokenProvider", "JwtAuthFilter",
          "SecurityConfig", "SecurityConfiguration", "PasswordEncoderConfig", "PasswordEncoder",
          "AuthController", "AdminInitializer",
          "AuthRequest", "AuthResponse", "RegisterRequest",
          "OtpService", "PasswordPolicy", "LoginResponse", "VerifyTwoFactorRequest",
          "ChangePasswordRequest", "ForgotPasswordRequest", "ResetPasswordRequest",
          "AdminUserController", "UserAdminService", "UserDto", "UpdateUserRoleRequest"
        ]
      },
      "frontend": {
        "modules": ["/context/authcontext", "/hooks/useauth", "/services/authservice", "/types/auth.", "/services/userservice", "/types/user"],
        "guards": ["ProtectedRoute", "AdminLayout"],
        "fenced": ["AuthContext", "useAuth", "authService", "userService"],
        "pages": [
          { "key": "ACCOUNT", "gate": "AUTH", "nav": true },
          { "key": "FORGOT_PASSWORD", "gate": "PUBLIC", "nav": false },
          { "key": "RESET_PASSWORD", "gate": "PUBLIC", "nav": false },
          { "key": "ADMIN_USERS", "gate": "ADMIN", "nav": true }
        ]
      },
      "config": {
        "env": ["JWT_SECRET", "OTP_TTL_MINUTES", "APP_BASE_URL"],
        "compose": []
      }
    },
    {
      "id": "shell",
      "core": true,
      "requires": [],
