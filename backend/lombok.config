# Root config for the module.
config.stopBubbling = true

# Copy @JsonProperty from a field onto Lombok-generated constructor params, so a Jackson creator
# (the @AllArgsConstructor) honors an explicit JSON name (e.g. a boolean `isX` field exposed as its
# intended key). Prevents a serialize/deserialize name mismatch from dropping the value.
lombok.copyableAnnotations += com.fasterxml.jackson.annotation.JsonProperty
